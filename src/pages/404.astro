---
import Layout from '../Layout.astro';
import '../styles/global.css';
---

<Layout>
  <section class="min-h-[60vh] flex flex-col items-center justify-center px-4 pt-28 pb-16 text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-primary">404</p>
    <h1 class="mt-2 text-3xl font-bold text-base-content">Pagina no encontrada</h1>
    <p class="mt-3 max-w-md text-sm text-base-content/70">
      La URL no existe o fue movida. Vuelve al inicio para seguir navegando.
    </p>
    <a href="/" class="btn btn-primary btn-sm mt-6">Volver al inicio</a>
  </section>
</Layout>
